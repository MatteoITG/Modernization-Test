<Application x:Class="RelayCrm.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:RelayCrm"
			 ShutdownMode="OnExplicitShutdown">
	<!-- The default system theme; only spacing, a few text styles and the grid defaults are set here. -->
	<Application.Resources>

		<local:FmtConverter x:Key="Fmt" />
		<local:ToneBrushConverter x:Key="ToneBrush" />
		<local:InitialsConverter x:Key="Initials" />
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<Style x:Key="PageTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="20" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<Style x:Key="Muted" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,12,0" />
		</Style>

		<Style x:Key="ErrorText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#C42B1C" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Visibility" Value="Collapsed" />
		</Style>

		<Style x:Key="EmptyText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="12" />
		</Style>

		<Style TargetType="Button">
			<Setter Property="MinWidth" Value="80" />
			<Setter Property="Padding" Value="10,3" />
		</Style>

		<Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Margin" Value="8,0,0,0" />
			<Setter Property="MinWidth" Value="88" />
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="2,2" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style x:Key="ReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<Style TargetType="DatePicker">
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>

		<Style TargetType="ComboBox">
			<Setter Property="Padding" Value="4,3" />
		</Style>

		<Style TargetType="GroupBox">
			<Setter Property="Padding" Value="6" />
			<Setter Property="Margin" Value="0,0,8,8" />
		</Style>

		<Style TargetType="DataGrid">
			<Setter Property="AutoGenerateColumns" Value="False" />
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="CanUserAddRows" Value="False" />
			<Setter Property="CanUserDeleteRows" Value="False" />
			<Setter Property="CanUserResizeRows" Value="False" />
			<Setter Property="SelectionMode" Value="Single" />
			<Setter Property="SelectionUnit" Value="FullRow" />
			<Setter Property="HeadersVisibility" Value="Column" />
			<Setter Property="GridLinesVisibility" Value="Horizontal" />
			<Setter Property="HorizontalGridLinesBrush" Value="#E3E3E3" />
			<Setter Property="RowHeight" Value="24" />
			<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
		</Style>

		<Style TargetType="DataGridCell">
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridCell">
						<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
							<ContentPresenter VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- right aligned numbers in the grids. -->
		<Style x:Key="NumberCell" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

	</Application.Resources>
</Application>
