<Window x:Class="RelayCrm.Dialogs.SignInDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Sign in to Relay" Width="440" Height="460"
		WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
			<TextBlock Text="Relay" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" />
			<TextBlock Text="Development sign-in: choose the user to work as. There are no passwords." TextWrapping="Wrap" Margin="0,4,0,0" />
		</StackPanel>
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button x:Name="buttonSignIn" Content="Sign in" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonSignIn_Click" />
			<Button Content="Exit" IsCancel="True" Style="{StaticResource DialogButton}" />
		</StackPanel>
		<ListBox x:Name="listUsers" SelectionChanged="listUsers_SelectionChanged" MouseDoubleClick="listUsers_MouseDoubleClick"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<DockPanel Margin="2,4">
						<Grid Width="34" Height="34" Margin="0,0,10,0">
							<Ellipse Fill="{Binding AvatarColor}" />
							<TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
									   HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Grid>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
							<TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
								<Run Text="{Binding Role, Mode=OneWay}" /> · <Run Text="{Binding Email, Mode=OneWay}" />
							</TextBlock>
						</StackPanel>
					</DockPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
