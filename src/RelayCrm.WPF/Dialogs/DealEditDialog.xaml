<Window x:Class="RelayCrm.Dialogs.DealEditDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Deal" Width="480" SizeToContent="Height"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<StackPanel Margin="14">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Title:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxTitle" TextChanged="textBox_TextChanged" />

			<TextBlock Grid.Row="2" Text="Company:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="2" Grid.Column="1" x:Name="comboBoxCompany" DisplayMemberPath="Text" SelectedValuePath="Id"
					  SelectionChanged="comboBoxCompany_SelectionChanged" />

			<TextBlock Grid.Row="4" Text="Primary contact:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="4" Grid.Column="1" x:Name="comboBoxContact" DisplayMemberPath="Text" SelectedValuePath="Id" />

			<TextBlock Grid.Row="6" Text="Amount (USD):" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="6" Grid.Column="1" x:Name="textBoxAmount" Width="160" HorizontalAlignment="Left" TextChanged="textBox_TextChanged" />

			<TextBlock Grid.Row="8" Text="Stage:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="8" Grid.Column="1" x:Name="comboBoxStage" DisplayMemberPath="Name" SelectedValuePath="Id" />

			<TextBlock Grid.Row="10" Text="Expected close:" Style="{StaticResource FieldLabel}" />
			<DatePicker Grid.Row="10" Grid.Column="1" x:Name="datePickerClose" Width="170" HorizontalAlignment="Left" />

			<TextBlock Grid.Row="12" Text="Owner:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="12" Grid.Column="1" x:Name="comboBoxOwner" DisplayMemberPath="Text" SelectedValuePath="Id" />
		</Grid>

		<TextBlock x:Name="labelError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button x:Name="buttonSave" Content="Save" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonSave_Click" />
			<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
		</StackPanel>
	</StackPanel>
</Window>
