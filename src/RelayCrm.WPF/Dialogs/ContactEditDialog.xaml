<Window x:Class="RelayCrm.Dialogs.ContactEditDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Contact" Width="520" SizeToContent="Height"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<StackPanel Margin="14">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Name:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxFirstName" ToolTip="First name" TextChanged="textBox_TextChanged" />
			<TextBox Grid.Row="0" Grid.Column="3" x:Name="textBoxLastName" ToolTip="Last name" TextChanged="textBox_TextChanged" />

			<TextBlock Grid.Row="2" Text="Job title:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="textBoxTitle" />

			<TextBlock Grid.Row="4" Text="Email:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="textBoxEmail" TextChanged="textBox_TextChanged" />

			<TextBlock Grid.Row="6" Text="Phone:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="textBoxPhone" />

			<TextBlock Grid.Row="8" Text="Company:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" x:Name="comboBoxCompany" DisplayMemberPath="Text" SelectedValuePath="Id" IsTextSearchEnabled="True" />

			<TextBlock Grid.Row="10" Text="Stage:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="10" Grid.Column="1" x:Name="comboBoxStage" />
			<ComboBox Grid.Row="10" Grid.Column="3" x:Name="comboBoxLeadSource" IsEditable="True" ToolTip="Lead source" />

			<TextBlock Grid.Row="12" Text="Owner:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3" x:Name="comboBoxOwner" DisplayMemberPath="Name" SelectedValuePath="Id" />

			<TextBlock Grid.Row="14" Text="Tags:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3" x:Name="textBoxTags" ToolTip="Comma separated" />
			<TextBlock Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="3" x:Name="labelTagsHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
		</Grid>

		<TextBlock x:Name="labelError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button Content="Save" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonSave_Click" />
			<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
		</StackPanel>
	</StackPanel>
</Window>
