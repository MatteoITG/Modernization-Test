<Window x:Class="RelayCrm.Dialogs.AdvancedFilterDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Advanced filter" Width="640" Height="400" MinWidth="520" MinHeight="300"
		WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
			<TextBlock Text="Show the rows that match" VerticalAlignment="Center" />
			<ComboBox x:Name="comboMatch" Width="70" Margin="6,0">
				<ComboBoxItem Content="all" />
				<ComboBoxItem Content="any" />
			</ComboBox>
			<TextBlock Text="of these conditions:" VerticalAlignment="Center" />
		</StackPanel>
		<TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
				   Text="Dates are entered as yyyy-MM-dd, amounts as plain numbers (2500000)." />

		<DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
			<StackPanel Orientation="Horizontal">
				<Button Content="Add condition" Margin="0,0,8,0" Click="buttonAdd_Click" />
				<Button Content="Clear all" Click="buttonClear_Click" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Apply" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonApply_Click" />
				<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
			</StackPanel>
		</DockPanel>

		<ListBox x:Name="listRules" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid Margin="0,3">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="160" />
							<ColumnDefinition Width="130" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" />
						<ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}"
								  DisplayMemberPath="Text" />
						<ComboBox Grid.Column="2" Margin="6,0,0,0" IsEditable="True" ItemsSource="{Binding Choices}"
								  Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasValue}" />
						<Button Grid.Column="3" Content="×" MinWidth="0" Width="26" FontSize="14" Padding="0" Margin="6,0,0,0" ToolTip="Remove the condition"
								Click="buttonRemove_Click" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
