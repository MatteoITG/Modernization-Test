<Window x:Class="RelayCrm.Dialogs.InviteUserDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Invite user" Width="420" SizeToContent="Height"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<StackPanel Margin="14">
		<TextBlock Text="The new user can sign in right away and gets the avatar colour that is next in the palette."
				   TextWrapping="Wrap" Margin="0,0,0,10" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock Grid.Row="0" Text="Name:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxName" TextChanged="textBox_TextChanged" />
			<TextBlock Grid.Row="2" Text="Email:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="2" Grid.Column="1" x:Name="textBoxEmail" TextChanged="textBox_TextChanged" />
			<TextBlock Grid.Row="4" Text="Role:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="4" Grid.Column="1" x:Name="comboBoxRole" Width="160" HorizontalAlignment="Left" />
		</Grid>
		<TextBlock x:Name="labelError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button Content="Invite" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonInvite_Click" />
			<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
		</StackPanel>
	</StackPanel>
</Window>
