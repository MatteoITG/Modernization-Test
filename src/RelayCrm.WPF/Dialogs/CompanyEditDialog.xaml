<Window x:Class="RelayCrm.Dialogs.CompanyEditDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Company" Width="540" SizeToContent="Height"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<StackPanel Margin="14">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Name:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="textBoxName"
					 TextChanged="textBoxName_TextChanged" LostKeyboardFocus="textBoxName_LostKeyboardFocus" />
			<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="labelNameWarning" Margin="0,3,0,0"
					   Text="A company with this name already exists." Foreground="#B25E00" Visibility="Collapsed" />

			<TextBlock Grid.Row="3" Text="Industry:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="3" Grid.Column="1" x:Name="comboIndustry" IsEditable="True" />
			<TextBlock Grid.Row="3" Grid.Column="3" Text="Size:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="3" Grid.Column="4" x:Name="comboSize" />

			<TextBlock Grid.Row="5" Text="Website:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="5" Grid.Column="1" x:Name="textBoxWebsite" />
			<TextBlock Grid.Row="5" Grid.Column="3" Text="Phone:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="5" Grid.Column="4" x:Name="textBoxPhone" />

			<TextBlock Grid.Row="7" Text="Address:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4" x:Name="textBoxAddress" />

			<TextBlock Grid.Row="9" Text="City:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="9" Grid.Column="1" x:Name="textBoxCity" />
			<TextBlock Grid.Row="9" Grid.Column="3" Text="Country:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="9" Grid.Column="4" x:Name="textBoxCountry" />

			<TextBlock Grid.Row="11" Text="Revenue:" Style="{StaticResource FieldLabel}" ToolTip="Annual revenue in USD" />
			<TextBox Grid.Row="11" Grid.Column="1" x:Name="textBoxRevenue" ToolTip="Annual revenue in USD" TextChanged="textBox_TextChanged" />
			<TextBlock Grid.Row="11" Grid.Column="3" Text="Owner:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="11" Grid.Column="4" x:Name="comboOwner" DisplayMemberPath="Name" SelectedValuePath="Id" />

			<TextBlock Grid.Row="13" Text="Tags:" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,3,12,0" />
			<Border Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="4" BorderThickness="1" Padding="6,4"
					BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
					Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
				<ItemsControl x:Name="listTags">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,2,14,2" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
		</Grid>

		<TextBlock x:Name="labelError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button Content="Save" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonSave_Click" />
			<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
		</StackPanel>
	</StackPanel>
</Window>
