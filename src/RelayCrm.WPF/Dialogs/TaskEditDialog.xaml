<Window x:Class="RelayCrm.Dialogs.TaskEditDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Task" Width="460" SizeToContent="Height"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
	<StackPanel Margin="14">
		<TextBlock x:Name="labelRelated" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Title:" Style="{StaticResource FieldLabel}" />
			<TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxTitle" TextChanged="textBoxTitle_TextChanged" />

			<TextBlock Grid.Row="2" Text="Due:" Style="{StaticResource FieldLabel}" />
			<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
				<DatePicker x:Name="datePickerDue" Width="160" />
				<TextBlock Text="Priority:" Style="{StaticResource FieldLabel}" Margin="18,0,8,0" />
				<ComboBox x:Name="comboBoxPriority" Width="100" />
			</StackPanel>

			<TextBlock Grid.Row="4" Text="Assignee:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="4" Grid.Column="1" x:Name="comboBoxAssignee" DisplayMemberPath="Name" />

			<TextBlock Grid.Row="6" x:Name="labelStatus" Text="Status:" Style="{StaticResource FieldLabel}" />
			<ComboBox Grid.Row="6" Grid.Column="1" x:Name="comboBoxStatus" Width="140" HorizontalAlignment="Left" />
		</Grid>

		<TextBlock x:Name="labelError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />

		<DockPanel Margin="0,14,0,0">
			<Button x:Name="buttonDelete" Content="Delete" Visibility="Collapsed" Click="buttonDelete_Click" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Save" IsDefault="True" Style="{StaticResource DialogButton}" Click="buttonSave_Click" />
				<Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
			</StackPanel>
		</DockPanel>
	</StackPanel>
</Window>
