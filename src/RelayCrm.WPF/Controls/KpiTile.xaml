<UserControl x:Class="RelayCrm.Controls.KpiTile"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:RelayCrm.Controls"
			 Margin="0,0,8,8">
	<Border x:Name="border"
			Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
			BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
			BorderThickness="1" Padding="10,8">
		<DockPanel>
			<TextBlock x:Name="labelTitle" DockPanel.Dock="Top" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
			<controls:Sparkline x:Name="sparkline" DockPanel.Dock="Bottom" Height="26" Margin="0,4,0,0" />
			<StackPanel>
				<StackPanel Orientation="Horizontal">
					<TextBlock x:Name="labelValue" FontSize="22" FontWeight="SemiBold" />
					<TextBlock x:Name="labelTrend" Margin="8,0,0,3" VerticalAlignment="Bottom" />
				</StackPanel>
				<TextBlock x:Name="labelCaption" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
			</StackPanel>
		</DockPanel>
	</Border>
</UserControl>
