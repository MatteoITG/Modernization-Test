<UserControl x:Class="RelayCrm.Views.ReportsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:RelayCrm.Controls">
	<DockPanel Margin="16,12,16,12">
		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
			<Button DockPanel.Dock="Right" Content="Export table..." Click="buttonExport_Click" />
			<TextBlock Text="Reports" Style="{StaticResource PageTitle}" />
			<TextBlock x:Name="labelSummary" Style="{StaticResource Muted}" Margin="12,4,0,0" />
		</DockPanel>

		<!-- each report: a description, a chart and a table with the same numbers -->
		<TabControl x:Name="tabReports" SelectionChanged="tabReports_SelectionChanged">
			<TabItem Header="Sales forecast">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelForecastDescription" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
					<controls:BarChart x:Name="chartForecast" DockPanel.Dock="Top" Height="260" Margin="0,0,0,10"
									   ToolTip="Click a month to see its open deals" />
					<DataGrid x:Name="gridForecast">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Month" Binding="{Binding Month}" SortMemberPath="MonthStart" Width="*" />
							<DataGridTextColumn Header="Deals" Binding="{Binding Deals}" Width="80" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Pipeline" Binding="{Binding Pipeline, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="Pipeline" Width="140" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Weighted" Binding="{Binding Weighted, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="Weighted" Width="140" ElementStyle="{StaticResource NumberCell}" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<TabItem Header="Win/loss analysis">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelWinLossDescription" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
					<Grid DockPanel.Dock="Top" Height="260" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="16" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>
						<DockPanel>
							<TextBlock DockPanel.Dock="Top" Text="Won and lost deals per month" Style="{StaticResource SectionTitle}" />
							<controls:BarChart x:Name="chartWinLoss" WholeNumbers="True" ToolTip="Click a month to see its deals" />
						</DockPanel>
						<DockPanel Grid.Column="2">
							<TextBlock DockPanel.Dock="Top" Text="Lost reasons" Style="{StaticResource SectionTitle}" />
							<controls:BarChart x:Name="chartReasons" Horizontal="True" WholeNumbers="True" />
						</DockPanel>
					</Grid>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="16" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>
						<DataGrid x:Name="gridWinLoss">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Month" Binding="{Binding Month}" SortMemberPath="MonthStart" Width="*" />
								<DataGridTextColumn Header="Won" Binding="{Binding Won}" Width="55" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="55" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Won value" Binding="{Binding WonValue, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="WonValue" Width="110" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Lost value" Binding="{Binding LostValue, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="LostValue" Width="110" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Win rate" Binding="{Binding WinRate, Converter={StaticResource Fmt}, ConverterParameter=Percent}" SortMemberPath="WinRate" Width="70" ElementStyle="{StaticResource NumberCell}" />
							</DataGrid.Columns>
						</DataGrid>
						<DataGrid x:Name="gridReasons" Grid.Column="2">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
								<DataGridTextColumn Header="Deals" Binding="{Binding Deals}" Width="55" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Value" Binding="{Binding Value, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="Value" Width="100" ElementStyle="{StaticResource NumberCell}" />
								<DataGridTextColumn Header="Share" Binding="{Binding Share, Converter={StaticResource Fmt}, ConverterParameter=Percent}" SortMemberPath="Share" Width="60" ElementStyle="{StaticResource NumberCell}" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</DockPanel>
			</TabItem>

			<TabItem Header="Activity per user">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelActivityDescription" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
					<controls:BarChart x:Name="chartActivity" DockPanel.Dock="Top" Height="280" Margin="0,0,0,10" Horizontal="True" Stacked="True" WholeNumbers="True" />
					<DataGrid x:Name="gridActivity">
						<DataGrid.Columns>
							<DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" />
							<DataGridTextColumn Header="Calls" Binding="{Binding Calls}" Width="70" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Emails" Binding="{Binding Emails}" Width="70" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Meetings" Binding="{Binding Meetings}" Width="70" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="70" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70" ElementStyle="{StaticResource NumberCell}" FontWeight="SemiBold" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<TabItem Header="Lead source conversion">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelLeadSourceDescription" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
					<controls:BarChart x:Name="chartLeadSource" DockPanel.Dock="Top" Height="260" Margin="0,0,0,10" WholeNumbers="True" />
					<DataGrid x:Name="gridLeadSource">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Lead source" Binding="{Binding Source}" Width="*" />
							<DataGridTextColumn Header="Contacts" Binding="{Binding Contacts}" Width="80" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Customers" Binding="{Binding Customers}" Width="80" ElementStyle="{StaticResource NumberCell}" />
							<DataGridTextColumn Header="Conversion" Binding="{Binding Conversion, Converter={StaticResource Fmt}, ConverterParameter=Percent}" SortMemberPath="Conversion" Width="90" ElementStyle="{StaticResource NumberCell}" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
