<UserControl x:Class="RelayCrm.Views.TasksView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<UserControl.Resources>
		<!-- the columns of every group grid -->
		<DataTemplate x:Key="DoneTemplate">
			<CheckBox IsChecked="{Binding Done, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
					  ToolTip="Complete or reopen the task" Click="checkDone_Click" />
		</DataTemplate>
		<DataTemplate x:Key="TitleTemplate">
			<TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Style.Triggers>
							<DataTrigger Binding="{Binding Done}" Value="True">
								<Setter Property="TextDecorations" Value="Strikethrough" />
								<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</DataTemplate>
		<DataTemplate x:Key="RelatedTemplate">
			<TextBlock TextTrimming="CharacterEllipsis">
				<Hyperlink Click="linkRelated_Click"><Run Text="{Binding RelatedText, Mode=OneWay}" /></Hyperlink>
			</TextBlock>
		</DataTemplate>
		<DataTemplate x:Key="DueTemplate">
			<TextBlock Text="{Binding DueText}" Foreground="{Binding DueTone, Converter={StaticResource ToneBrush}}" />
		</DataTemplate>
		<DataTemplate x:Key="PriorityTemplate">
			<TextBlock Text="{Binding PriorityText}" Foreground="{Binding PriorityTone, Converter={StaticResource ToneBrush}}" />
		</DataTemplate>
	</UserControl.Resources>

	<DockPanel Margin="16,12,16,12">
		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
				<RadioButton x:Name="radioMine" Content="My tasks" GroupName="Scope" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="radioScope_Checked" />
				<RadioButton x:Name="radioAll" Content="Everybody's" GroupName="Scope" Margin="0,0,16,0" VerticalAlignment="Center" Checked="radioScope_Checked" />
				<Button Content="New task..." Click="buttonNew_Click" />
			</StackPanel>
			<TextBlock Text="Tasks" Style="{StaticResource PageTitle}" />
			<TextBlock x:Name="labelCount" Style="{StaticResource Muted}" Margin="12,4,0,0" />
		</DockPanel>

		<Grid>
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<!-- one group box per group (Overdue, Today, This week, Later, Done), filled in code -->
				<StackPanel x:Name="panelGroups" />
			</ScrollViewer>
			<StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
				<TextBlock Text="No tasks" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
				<TextBlock Text="You're all caught up. Add a task to plan your next step." Style="{StaticResource Muted}" Margin="0,4,0,0" />
			</StackPanel>
		</Grid>
	</DockPanel>

</UserControl>
