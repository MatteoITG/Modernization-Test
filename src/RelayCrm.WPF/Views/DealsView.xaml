<UserControl x:Class="RelayCrm.Views.DealsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<DockPanel Margin="16,12,16,12">
		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
				<RadioButton x:Name="radioBoard" Content="Board" GroupName="Mode" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="radioMode_Checked" />
				<RadioButton x:Name="radioList" Content="List" GroupName="Mode" Margin="0,0,16,0" VerticalAlignment="Center" Checked="radioMode_Checked" />
				<Button Content="New deal..." Click="buttonNew_Click" />
			</StackPanel>
			<TextBlock Text="Deals" Style="{StaticResource PageTitle}" />
			<TextBlock x:Name="labelSummary" Style="{StaticResource Muted}" Margin="12,4,0,0" />
		</DockPanel>

		<WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
			<TextBlock Text="Owner:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
			<ComboBox x:Name="comboBoxOwner" Width="150" DisplayMemberPath="Text" SelectedValuePath="Id" SelectionChanged="filter_Changed" />
			<TextBlock Text="Close from:" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
			<DatePicker x:Name="datePickerFrom" Width="160" SelectedDateChanged="filter_Changed" />
			<TextBlock Text="to:" Style="{StaticResource FieldLabel}" Margin="6,0,6,0" />
			<DatePicker x:Name="datePickerTo" Width="160" SelectedDateChanged="filter_Changed" />
			<TextBlock Text="Amount from:" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
			<TextBox x:Name="textBoxMin" Width="80" TextChanged="filter_Changed" />
			<TextBlock Text="to:" Style="{StaticResource FieldLabel}" Margin="6,0,6,0" />
			<TextBox x:Name="textBoxMax" Width="80" TextChanged="filter_Changed" />
			<TextBlock VerticalAlignment="Center" Margin="16,0,0,0">
				<Hyperlink Click="linkClear_Click">Clear filters</Hyperlink>
			</TextBlock>
		</WrapPanel>

		<Border x:Name="panelCaption" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,4" Visibility="Collapsed"
				Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" BorderThickness="1"
				BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
			<TextBlock Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}">
				<Run x:Name="runCaption" FontWeight="SemiBold" /><Run Text="  " /><Hyperlink Click="linkClear_Click">Show all deals</Hyperlink>
			</TextBlock>
		</Border>

		<Grid>
			<!-- board: one list per stage; drag a card to another stage or use its context menu -->
			<ScrollViewer x:Name="boardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
				<ItemsControl x:Name="board">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Width="240" Margin="0,0,10,0" BorderThickness="1"
									BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
									Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
								<DockPanel>
									<Border DockPanel.Dock="Top" Height="4" Background="{Binding ToneBrush}" />
									<StackPanel DockPanel.Dock="Top" Margin="8,6,8,6">
										<DockPanel>
											<TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Muted}" />
											<TextBlock Text="{Binding Stage.Name}" FontWeight="SemiBold" />
										</DockPanel>
										<TextBlock Text="{Binding TotalText}" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
									</StackPanel>
									<ListBox ItemsSource="{Binding Cards}" Tag="{Binding}" AllowDrop="True"
											 Background="Transparent" BorderThickness="0"
											 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
											 PreviewMouseLeftButtonDown="cards_PreviewMouseLeftButtonDown"
											 PreviewMouseMove="cards_PreviewMouseMove"
											 DragOver="cards_DragOver" Drop="cards_Drop"
											 MouseDoubleClick="cards_MouseDoubleClick">
										<ListBox.ItemContainerStyle>
											<Style TargetType="ListBoxItem">
												<Setter Property="HorizontalContentAlignment" Value="Stretch" />
												<Setter Property="Padding" Value="0" />
												<Setter Property="Margin" Value="6,0,6,6" />
											</Style>
										</ListBox.ItemContainerStyle>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<Border BorderThickness="1" Padding="8,6"
														BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
														Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
														ContextMenuOpening="card_ContextMenuOpening"
														ToolTip="Drag to another stage, double-click to open, right-click for more">
													<Border.ContextMenu>
														<ContextMenu />
													</Border.ContextMenu>
													<StackPanel>
														<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
																   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
														<TextBlock Text="{Binding Meta}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
																   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
														<DockPanel Margin="0,4,0,0">
															<TextBlock DockPanel.Dock="Right" Text="{Binding OwnerInitials}" ToolTip="{Binding OwnerName}"
																	   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontWeight="SemiBold" />
															<TextBlock Text="{Binding CloseTag}" Foreground="{Binding CloseTone, Converter={StaticResource ToneBrush}}" FontSize="11" />
														</DockPanel>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</DockPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!-- list -->
			<Grid x:Name="panelList" Visibility="Collapsed">
				<DataGrid x:Name="dataGrid" MouseDoubleClick="dataGrid_MouseDoubleClick" ToolTip="Double-click to open the deal; right-click for more">
					<DataGrid.ContextMenu>
						<ContextMenu Opened="listMenu_Opened">
							<MenuItem Header="_Open" FontWeight="Bold" Click="menuOpen_Click" />
							<MenuItem Header="_Edit..." Click="menuEdit_Click" />
							<MenuItem x:Name="menuMoveTo" Header="_Move to" />
						</ContextMenu>
					</DataGrid.ContextMenu>
					<DataGrid.Columns>
						<DataGridTextColumn Header="Deal" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
						<DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.5*" />
						<DataGridTextColumn Header="Contact" Binding="{Binding ContactName}" Width="1.2*" />
						<DataGridTemplateColumn Header="Stage" SortMemberPath="StageName" Width="110">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding StageName}" FontWeight="SemiBold">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground" Value="#0054A6" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsWon}" Value="True">
														<Setter Property="Foreground" Value="#107C10" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsLost}" Value="True">
														<Setter Property="Foreground" Value="#C42B1C" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="Amount" Width="100" ElementStyle="{StaticResource NumberCell}" />
						<DataGridTemplateColumn Header="Expected close" SortMemberPath="ExpectedCloseDate" Width="150">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding CloseTag}" Foreground="{Binding CloseTone, Converter={StaticResource ToneBrush}}" ToolTip="{Binding CloseText}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Probability" Binding="{Binding ProbabilityText}" SortMemberPath="Probability" Width="80" ElementStyle="{StaticResource NumberCell}" />
						<DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" Width="1.2*" />
					</DataGrid.Columns>
				</DataGrid>
				<StackPanel x:Name="emptyList" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
					<TextBlock Text="No deals match" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
					<TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0">
						<Hyperlink Click="linkClear_Click">Clear the filters</Hyperlink> to see all deals.
					</TextBlock>
				</StackPanel>
			</Grid>
		</Grid>
	</DockPanel>
</UserControl>
