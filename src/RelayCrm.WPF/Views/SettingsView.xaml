<UserControl x:Class="RelayCrm.Views.SettingsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<DockPanel Margin="16,12,16,12">
		<TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" Margin="0,0,0,10" />

		<TabControl x:Name="tabControl">
			<!-- profile of the signed in user -->
			<TabItem x:Name="tabProfile" Header="Profile">
				<StackPanel Margin="12" HorizontalAlignment="Left" Width="460">
					<DockPanel Margin="0,0,0,14">
						<Grid Width="56" Height="56" Margin="0,0,12,0">
							<Ellipse x:Name="ellipseProfile" Fill="#4F46E5" />
							<TextBlock x:Name="labelProfileInitials" Foreground="White" FontSize="20" FontWeight="SemiBold"
									   HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Grid>
						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="labelProfileName" FontSize="15" FontWeight="SemiBold" />
							<TextBlock x:Name="labelProfileRole" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
						</StackPanel>
					</DockPanel>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Text="Name:" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Column="1" x:Name="textBoxProfileName" TextChanged="textBoxProfile_TextChanged" />
						<TextBlock Grid.Row="2" Text="Email:" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="2" Grid.Column="1" x:Name="textBoxProfileEmail" TextChanged="textBoxProfile_TextChanged" />
						<TextBlock Grid.Row="4" Text="Avatar colour:" Style="{StaticResource FieldLabel}" />
						<ItemsControl Grid.Row="4" Grid.Column="1" x:Name="listColors">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Width="28" Height="28" MinWidth="0" Padding="0" Margin="0,0,6,0" Background="{Binding Brush}"
											ToolTip="{Binding Color}" Click="buttonColor_Click">
										<TextBlock Text="{Binding Check}" Foreground="White" FontWeight="Bold" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
					<TextBlock x:Name="labelProfileError" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />
					<Button Content="Save profile" HorizontalAlignment="Left" Margin="0,14,0,0" Click="buttonSaveProfile_Click" />
				</StackPanel>
			</TabItem>

			<!-- users and roles -->
			<TabItem x:Name="tabUsers" Header="Users">
				<DockPanel Margin="8">
					<DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
						<Button x:Name="buttonInvite" DockPanel.Dock="Right" Content="Invite user..." Click="buttonInvite_Click" />
						<StackPanel>
							<TextBlock x:Name="labelUsersTitle" Style="{StaticResource SectionTitle}" Margin="0" />
							<TextBlock x:Name="labelUsersHint" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
						</StackPanel>
					</DockPanel>
					<DataGrid x:Name="gridUsers">
						<DataGrid.Columns>
							<DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid Width="22" Height="22">
											<Ellipse Fill="{Binding AvatarColor}" />
											<TextBlock Text="{Binding Name, Converter={StaticResource Initials}}" Foreground="White" FontSize="9" FontWeight="SemiBold"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" FontWeight="SemiBold" />
							<DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
							<DataGridTemplateColumn Header="Role" SortMemberPath="Role" Width="120">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<ComboBox SelectedItem="{Binding Role, Mode=OneWay}" Margin="0,1"
												  ItemsSource="{Binding Tag.Roles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
												  IsEnabled="{Binding Tag.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}}"
												  SelectionChanged="comboRole_SelectionChanged" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTemplateColumn Header="Active" SortMemberPath="Active" Width="60">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox IsChecked="{Binding Active, Mode=OneWay}" HorizontalAlignment="Center"
												  IsEnabled="{Binding Tag.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}}"
												  Click="checkActive_Click" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Owns" Binding="{Binding OwnedText}" Width="2*" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- pipeline stages -->
			<TabItem x:Name="tabStages" Header="Pipeline stages">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelStagesHint" DockPanel.Dock="Top" Style="{StaticResource Muted}" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,8"
							   Text="Rename the stages, change their win probability and order. Won and Lost always stay last. Open deals get the new probability of their stage." />
					<StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
						<Button x:Name="buttonMoveUp" Content="Move up" Margin="0,0,0,6" Click="buttonMoveUp_Click" />
						<Button x:Name="buttonMoveDown" Content="Move down" Margin="0,0,0,18" Click="buttonMoveDown_Click" />
						<Button x:Name="buttonSaveStages" Content="Save stages" IsEnabled="False" Click="buttonSaveStages_Click" />
					</StackPanel>
					<DataGrid x:Name="gridStages" IsReadOnly="False" SelectionUnit="FullRow" CanUserSortColumns="False"
							  SelectionChanged="gridStages_SelectionChanged" CellEditEnding="gridStages_CellEditEnding">
						<DataGrid.Columns>
							<DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width="40" />
							<DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="2*" />
							<DataGridTextColumn Header="Probability %" Binding="{Binding Probability, UpdateSourceTrigger=LostFocus}" Width="100" />
							<DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="70" />
							<DataGridTextColumn Header="Deals" Binding="{Binding Deals}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource NumberCell}" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- tags -->
			<TabItem x:Name="tabTags" Header="Tags">
				<DockPanel Margin="8">
					<TextBlock x:Name="labelTagsTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" />
					<TextBlock x:Name="labelTagsHint" DockPanel.Dock="Top" Style="{StaticResource Muted}" HorizontalAlignment="Left" Margin="0,0,0,8"
							   Text="Tags label companies and contacts. Removing a tag takes it off every record." />
					<StackPanel x:Name="panelAddTag" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
						<TextBox x:Name="textBoxNewTag" Width="200" KeyDown="textBoxNewTag_KeyDown" />
						<Button Content="Add tag" Margin="6,0,0,0" Click="buttonAddTag_Click" />
						<Button x:Name="buttonRemoveTag" Content="Remove selected" Margin="6,0,0,0" Click="buttonRemoveTag_Click" />
					</StackPanel>
					<DataGrid x:Name="gridTags" MaxWidth="560" HorizontalAlignment="Left">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="*" FontWeight="SemiBold" />
							<DataGridTextColumn Header="Used by" Binding="{Binding UsageText}" SortMemberPath="Usage" Width="2*" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- demo data -->
			<TabItem Header="Demo data">
				<StackPanel Margin="12" HorizontalAlignment="Left" MaxWidth="520">
					<TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
							   Text="Relay ships with fictional sample data. Resetting it deletes every change and seeds the companies, contacts, deals, activities, tasks and users again." />
					<TextBlock x:Name="labelDemoNote" Style="{StaticResource Muted}" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,10" />
					<Button x:Name="buttonResetDemo" Content="Reset demo data..." HorizontalAlignment="Left" Click="buttonResetDemo_Click" />
				</StackPanel>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
