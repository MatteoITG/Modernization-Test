<UserControl x:Class="RelayCrm.Views.ContactDetailView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<DockPanel Margin="16,10,16,12">
		<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8">
			<Hyperlink Click="linkBack_Click">◀ Back to contacts</Hyperlink>
		</TextBlock>

		<!-- header -->
		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
			<Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,12,0" VerticalAlignment="Top">
				<Ellipse x:Name="ellipseAvatar" Fill="#4F46E5" />
				<TextBlock x:Name="labelInitials" Foreground="White" FontSize="18" FontWeight="SemiBold"
						   HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Grid>
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
				<Button x:Name="buttonLogActivity" Content="Log activity..." Margin="0,0,6,0" Click="buttonLogActivity_Click" />
				<Button x:Name="buttonEdit" Content="Edit..." Margin="0,0,6,0" Click="buttonEdit_Click" />
				<Button x:Name="buttonNewDeal" Content="New deal..." Margin="0,0,6,0" Click="buttonNewDeal_Click" />
				<Button x:Name="buttonAddTask" Content="Add task..." Margin="0,0,6,0" Click="buttonAddTask_Click" />
				<Button x:Name="buttonDelete" Content="Delete" Click="buttonDelete_Click" />
			</StackPanel>
			<StackPanel>
				<TextBlock>
					<Run x:Name="runName" FontSize="20" FontWeight="SemiBold" />
					<Run Text="  " /><Run x:Name="runStage" FontWeight="SemiBold" />
				</TextBlock>
				<TextBlock x:Name="labelTitleAt" Margin="0,2,0,0">
					<Run x:Name="runTitleAt" /><Run Text=" " /><Hyperlink x:Name="linkCompany" Click="linkCompany_Click"><Run x:Name="runCompany" /></Hyperlink>
				</TextBlock>
				<TextBlock x:Name="labelOwner" Style="{StaticResource Muted}" HorizontalAlignment="Left" Margin="0,2,0,0" />
			</StackPanel>
		</DockPanel>

		<TabControl x:Name="tabControl">
			<TabItem Header="Overview">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="10" MaxWidth="760" HorizontalAlignment="Left">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="260" />
							<ColumnDefinition Width="24" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="260" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Text="Email" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxEmail" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="0" Grid.Column="3" Text="Phone" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="0" Grid.Column="4" x:Name="textBoxPhone" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="1" Text="Company" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="1" Grid.Column="1" x:Name="textBoxCompany" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="1" Grid.Column="3" Text="Job title" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="1" Grid.Column="4" x:Name="textBoxJobTitle" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="2" Text="Lifecycle stage" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="2" Grid.Column="1" x:Name="textBoxStage" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="2" Grid.Column="3" Text="Lead source" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="2" Grid.Column="4" x:Name="textBoxLeadSource" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="3" Text="Owner" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="3" Grid.Column="1" x:Name="textBoxOwner" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="3" Grid.Column="3" Text="Created" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="3" Grid.Column="4" x:Name="textBoxCreated" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="4" Text="Last contacted" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="textBoxLastContacted" Style="{StaticResource ReadOnlyField}" />
						<TextBlock Grid.Row="5" Text="Tags" Style="{StaticResource FieldLabel}" />
						<TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" x:Name="textBoxTags" Style="{StaticResource ReadOnlyField}" />
					</Grid>
				</ScrollViewer>
			</TabItem>

			<TabItem x:Name="tabActivity" Header="Activity">
				<Grid>
					<ListBox x:Name="listActivity" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="4,5">
									<TextBlock>
										<Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding TitleBrush, Mode=OneWay}" />
										<Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
									</TextBlock>
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<TextBlock x:Name="emptyActivity" Text="No activities yet. Log a call, an email or a meeting." Style="{StaticResource EmptyText}" />
				</Grid>
			</TabItem>

			<TabItem x:Name="tabDeals" Header="Deals">
				<Grid>
					<DataGrid x:Name="gridDeals" BorderThickness="0" MouseDoubleClick="gridDeals_MouseDoubleClick" ToolTip="Double-click to open the deal">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Deal" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
							<DataGridTextColumn Header="Amount · company" Binding="{Binding Description}" Width="2*" />
							<DataGridTemplateColumn Header="Stage" SortMemberPath="StageName" Width="110">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding StageName}" FontWeight="SemiBold" Foreground="{Binding StageTone, Converter={StaticResource ToneBrush}}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Close" Binding="{Binding Meta}" Width="1.5*" />
						</DataGrid.Columns>
					</DataGrid>
					<TextBlock x:Name="emptyDeals" Text="No deals with this contact as primary contact." Style="{StaticResource EmptyText}" />
				</Grid>
			</TabItem>

			<TabItem x:Name="tabTasks" Header="Tasks">
				<Grid>
					<DataGrid x:Name="gridTasks" BorderThickness="0" MouseDoubleClick="gridTasks_MouseDoubleClick" ToolTip="Double-click to edit the task">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="2*" />
							<DataGridTextColumn Header="Due" Binding="{Binding Due}" SortMemberPath="DueDate" Width="1.5*" />
							<DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="80">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Priority}" Foreground="{Binding Priority, Converter={StaticResource ToneBrush}, ConverterParameter=Priority}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="80">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource ToneBrush}, ConverterParameter=TaskStatus}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
					<TextBlock x:Name="emptyTasks" Text="No tasks for this contact." Style="{StaticResource EmptyText}" />
				</Grid>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
