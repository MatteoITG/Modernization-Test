<UserControl x:Class="RelayCrm.Views.DashboardView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:RelayCrm.Controls">
	<DockPanel>
		<DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="Period:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
				<ComboBox x:Name="comboPeriod" Width="110" SelectionChanged="comboPeriod_SelectionChanged">
					<ComboBoxItem Content="This month" />
					<ComboBoxItem Content="This quarter" />
					<ComboBoxItem Content="This year" />
				</ComboBox>
			</StackPanel>
			<StackPanel>
				<TextBlock x:Name="labelGreeting" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
				<TextBlock x:Name="labelPeriod" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
			</StackPanel>
		</DockPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="16,0,8,8">

				<UniformGrid Rows="1">
					<controls:KpiTile x:Name="kpiPipeline" Title="Open pipeline" ToolTip="Show the open deals" />
					<controls:KpiTile x:Name="kpiWon" Title="Won revenue" ToolTip="Show the deals won in the period" />
					<controls:KpiTile x:Name="kpiWinRate" Title="Win rate" ToolTip="Show the deals closing in the period" />
					<controls:KpiTile x:Name="kpiAverage" Title="Average deal size" ToolTip="Show the deals won in the period" />
				</UniformGrid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<GroupBox Header="Pipeline by stage">
						<controls:BarChart x:Name="chartPipeline" Height="230" Horizontal="True" />
					</GroupBox>
					<GroupBox Grid.Column="1" x:Name="groupWon" Header="Won revenue per week">
						<controls:BarChart x:Name="chartWon" Height="230" />
					</GroupBox>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<GroupBox Header="Open pipeline by owner">
						<controls:BarChart x:Name="chartOwners" Height="250" Horizontal="True" />
					</GroupBox>

					<GroupBox Grid.Column="1">
						<GroupBox.Header>
							<TextBlock x:Name="labelTasks" Text="My tasks today" />
						</GroupBox.Header>
						<DockPanel Height="250">
							<TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,4,0,0">
								<Hyperlink Click="linkTasksAll_Click">All tasks</Hyperlink>
							</TextBlock>
							<Grid>
								<ListBox x:Name="listTasks" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										 MouseDoubleClick="listTasks_MouseDoubleClick" ToolTip="Double-click to edit the task">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,3">
												<TextBlock>
													<Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
													<Run Text="{Binding Badge, Mode=OneWay}" Foreground="{Binding BadgeTone, Converter={StaticResource ToneBrush}, Mode=OneWay}" />
												</TextBlock>
												<TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
												<TextBlock Text="{Binding Meta}" Foreground="{Binding IconTone, Converter={StaticResource ToneBrush}}" />
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
								<TextBlock x:Name="emptyTasks" Text="Nothing due today. Enjoy the calm." Style="{StaticResource EmptyText}" />
							</Grid>
						</DockPanel>
					</GroupBox>

					<GroupBox Grid.Column="2" Header="Recent activity">
						<DockPanel Height="250">
							<TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,4,0,0">
								<Hyperlink Click="linkActivityAll_Click">All activities</Hyperlink>
							</TextBlock>
							<Grid>
								<ListBox x:Name="listActivity" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										 MouseDoubleClick="listActivity_MouseDoubleClick" ToolTip="Double-click to open the related record">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,3">
												<TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
												<TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" HorizontalAlignment="Left" FontSize="11" />
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
								<TextBlock x:Name="emptyActivity" Text="No activity yet." Style="{StaticResource EmptyText}" />
							</Grid>
						</DockPanel>
					</GroupBox>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3*" />
						<ColumnDefinition Width="2*" />
					</Grid.ColumnDefinitions>
					<GroupBox Header="Deals closing in the next 30 days">
						<Grid>
							<DataGrid x:Name="gridClosing" MaxHeight="280" MouseDoubleClick="gridClosing_MouseDoubleClick" ToolTip="Double-click to open the deal">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Deal" Binding="{Binding Title}" Width="2*" />
									<DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.5*" />
									<DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="Amount" Width="Auto" ElementStyle="{StaticResource NumberCell}" />
									<DataGridTextColumn Header="Close date" Binding="{Binding CloseDate, Converter={StaticResource Fmt}, ConverterParameter=Date}" SortMemberPath="CloseDate" Width="Auto" />
									<DataGridTextColumn Header="Probability" Binding="{Binding ProbabilityText}" SortMemberPath="Probability" Width="Auto" ElementStyle="{StaticResource NumberCell}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="emptyClosing" Text="No open deals close in the next 30 days." Style="{StaticResource EmptyText}" />
						</Grid>
					</GroupBox>
					<GroupBox Grid.Column="1">
						<GroupBox.Header>
							<TextBlock x:Name="labelAccounts" Text="Top accounts" />
						</GroupBox.Header>
						<Grid>
							<DataGrid x:Name="gridAccounts" MaxHeight="280" MouseDoubleClick="gridAccounts_MouseDoubleClick" ToolTip="Double-click to open the company">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*" />
									<DataGridTextColumn Header="Won revenue" Binding="{Binding WonRevenue, Converter={StaticResource Fmt}, ConverterParameter=Money}" SortMemberPath="WonRevenue" Width="Auto" ElementStyle="{StaticResource NumberCell}" />
									<DataGridTextColumn Header="Deals" Binding="{Binding Deals}" Width="Auto" ElementStyle="{StaticResource NumberCell}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="emptyAccounts" Text="No deals won in this period yet." Style="{StaticResource EmptyText}" />
						</Grid>
					</GroupBox>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
